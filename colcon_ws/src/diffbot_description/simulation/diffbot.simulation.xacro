<?xml version="1.0"?>
<robot xmlns:xacro="http://ros.org/wiki/xacro">

  <xacro:macro name="diffbot_simulation" params="prefix use_magnetic_guide:=^|true use_gnss:=^|true">

    <!-- =============== Simulation =============== -->
    <simulation>
      <sensor name="lidar_link" type="lidar">
        <update_rate>30</update_rate>
        <ray>
          <scan>
            <horizontal>
              <samples>400</samples>
              <resolution>1</resolution>
              <min_angle>-3.1415</min_angle>
              <max_angle>3.1415</max_angle>
            </horizontal>
          </scan>
          <range>
            <min>0.05</min>
            <max>20.0</max>
            <resolution>0.01</resolution>
          </range>
          <noise>
            <type>gaussian</type>
            <mean>0.0</mean>
            <stddev>0.01</stddev>
          </noise>
        </ray>
        <topicName>/lidar/scan</topicName>
        <frameName>lidar_link</frameName>
      </sensor>

      <sensor name="camera_link" type="camera">
        <update_rate>10.0</update_rate>
        <horizontal_fov>1.3962634</horizontal_fov>
        <image>
          <width>800</width>
          <height>600</height>
        </image>
        <clip>
          <near>0.02</near>
          <far>300</far>
        </clip>
        <cameraName>/camera</cameraName>
        <imageTopicName>image_raw</imageTopicName>
        <cameraInfoTopicName>camera_info</cameraInfoTopicName>
        <frameName>camera_link</frameName>
      </sensor>

      <sensor name="depth_camera_link" type="depth_camera">
        <update_rate>10.0</update_rate>
        <horizontal_fov>1.3962634</horizontal_fov>
        <image>
          <width>320</width>
          <height>240</height>
        </image>
        <clip>
          <near>0.02</near>
          <far>300</far>
        </clip>
        <cameraName>/depth_camera</cameraName>
        <imageTopicName>depth_image_raw</imageTopicName>
        <cameraInfoTopicName>depth_camera_info</cameraInfoTopicName>
        <frameName>depth_camera_link</frameName>
      </sensor>
      <!-- ============ v1.4.0: 磁気誘導 (ラインセンサ) ============ -->
      <!-- AGV 用の磁気ラインセンサ (MGS1600 / UDS-1213 相当)。バー幅 160 mm を
           1 mm ピッチの素子で見て、テープの横位置 [m] (+左) と左右マーカを
           simulation_extra_interfaces/MagneticGuide で
           /diffbot/magnetic_guide_link/magnetic_guide に publish する。
           テープは sim_props_description の magnetic_course を spawn して置く。
           min/max_height はバー面 (床上 30 mm) からの測定可能距離。 -->
      <xacro:if value="${use_magnetic_guide}">
      <sensor name="magnetic_guide_link" type="magnetic_guide">
        <update_rate>50</update_rate>
        <width>0.16</width>
        <pitch>0.001</pitch>
        <min_height>0.01</min_height>
        <max_height>0.06</max_height>
        <fork>nearest</fork>
        <noise>
          <stddev>0.0</stddev>
        </noise>
      </sensor>
      </xacro:if>

      <!-- ============ v1.4.0: GNSS (受信機モデル + 空の見え方) ============ -->
      <!-- gnss_sky_view がアンテナから衛星ごとにレイを打ち、直達 / 反射 (NLOS) /
           遮蔽を判定する。これ自体は ROS へ publish せず、同じリンクの
           <sensor type="gnss"> が受信機モデルの入力として読む。gnss_canyon を
           spawn してビルの谷間に入れると測位品質が落ちる様子が見られる。
           gnss_sky_view が無いときは受信機は真値をそのまま報告する。
           stochastic_error を false にすると乱数由来の誤差が消え、幾何が生む
           誤差だけが残るので、同じ場所では毎回同じ誤差になる。 -->
      <xacro:if value="${use_gnss}">
      <sensor name="gnss_antenna_link" type="gnss">
        <update_rate>5.0</update_rate>
        <origin_latitude>36.549774</origin_latitude>
        <origin_longitude>139.928772</origin_longitude>
        <origin_altitude>100.0</origin_altitude>
        <reconvergence_sec>8.0</reconvergence_sec>
        <lock_seconds_for_fix>8.0</lock_seconds_for_fix>
        <wrong_fix_probability>0.01</wrong_fix_probability>
        <stochastic_error>true</stochastic_error>
        <seed>20260914</seed>
      </sensor>

      <sensor name="gnss_antenna_link" type="gnss_sky_view">
        <update_rate>5.0</update_rate>
        <satellite_count>24</satellite_count>
        <elevation_mask>15.0</elevation_mask>
        <max_range>500.0</max_range>
        <seed>1</seed>
        <!-- 雑草や磁気テープはトリガコライダなので、既定 (false) のままなら衛星を遮らない -->
        <hit_triggers>false</hit_triggers>
        <!-- 1 バウンス反射 (NLOS) の探索。spacing を半分にするとレイ数は 4 倍 -->
        <reflections>true</reflections>
        <reflection_spacing>2.5</reflection_spacing>
        <reflection_loss_db>-13.0</reflection_loss_db>
      </sensor>
      </xacro:if>

    </simulation>

  </xacro:macro>
    
</robot>
