# Apply a constant wrench to a link of a spawned entity, expressed in the
# world frame with ROS axis conventions (x forward, y left, z up).
# The force is applied at the link's center of mass every physics step for
# `duration` simulated seconds (0 = exactly one physics step). Time is counted
# in simulation steps, so the behaviour is identical under time_scale and
# step_simulation. Calling again for the same link adds another wrench;
# reset_simulation clears all active wrenches.
string entity                  # entity name as listed by get_entities
string link                    # link name; empty targets the base link
geometry_msgs/Wrench wrench    # force [N] and torque [N m], world frame
float64 duration               # simulated seconds; 0 = one physics step
---
# Result codes follow simulation_interfaces/Result semantics.
uint8 RESULT_OK = 1
uint8 RESULT_NOT_FOUND = 2         # entity or link not found
uint8 RESULT_OPERATION_FAILED = 4

uint8 result
string error_message
