# Query the collision records accumulated for spawned entities.
# Every link of every spawned entity is monitored; records aggregate per
# (entity, link, other object). Wheels resting on the floor produce records
# with other == "Plane" (the built-in floor) — filter by `other` on the
# caller side to ignore expected contacts.
# reset_simulation with SCOPE_STATE clears all records.
string entity        # empty = records of every entity
bool clear           # true = clear the returned records after reading
---
uint8 RESULT_OK = 1
uint8 RESULT_OPERATION_FAILED = 4

uint8 result
string error_message
ContactRecord[] contacts
