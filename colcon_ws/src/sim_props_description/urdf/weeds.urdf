<?xml version="1.0"?>
<!-- LiDAR には映るが走行を妨げない物体 (雑草) の例。
     <collision_material><sensor_only value="true"/> を付けた <collision> は
     Unity の Collider.isTrigger になる。トリガはレイキャストには当たる一方、
     接触解決には入らないので、ロボットはそのまま突っ切り get_contact_events
     にも残らない。collision を持たないリンクでは LiDAR のレイが当たらず
     「何も無い」のと同じになるため、collision は普通に書いて sensor_only で
     トリガにするのが正しい書き方。

     株ごとにリンクを作らないこと: リンクは全て ArticulationBody になり、
     PhysX は 1 つの articulation につき 64 body までしか持てない。リンクは
     1 つにして <collision> を並べる (リンクあたりのコライダ数に上限は無い)。
     また、トリガだけのボディは何にも支えられないので world リンクに fixed で
     吊るす。そうしないと床をすり抜けて落ち続ける。

     56 株、x=1.5..4.0 / y=-0.9..0.9 に配置。草丈は 0.45-0.75 m で、
     diffbot の LiDAR (床上 0.27 m) のスキャン面より高い。 -->
<robot name="weeds">
  <material name="weed_green">
    <color rgba="0.25 0.6 0.2 1.0"/>
  </material>

  <collision_material name="weed">
    <sensor_only value="true"/>
  </collision_material>

  <link name="world"/>
  <link name="weeds_link">
