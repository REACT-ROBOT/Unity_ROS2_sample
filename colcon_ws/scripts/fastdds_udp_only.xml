<?xml version="1.0" encoding="UTF-8"?>
<!-- Disable the FastDDS shared-memory transport (UDP only).
     Killed processes leak /dev/shm/fastrtps_* segments; enough of them break
     DDS discovery inside the container. UDP-only avoids the problem for
     automated test loops that start/stop nodes frequently. -->
<profiles xmlns="http://www.eprosima.com/XMLSchemas/fastRTPS_Profiles">
  <transport_descriptors>
    <transport_descriptor>
      <transport_id>udp_only</transport_id>
      <type>UDPv4</type>
    </transport_descriptor>
  </transport_descriptors>
  <participant profile_name="udp_only_participant" is_default_profile="true">
    <rtps>
      <userTransports>
        <transport_id>udp_only</transport_id>
      </userTransports>
      <useBuiltinTransports>false</useBuiltinTransports>
    </rtps>
  </participant>
</profiles>
