# ROS distro is selectable: humble (Ubuntu 22.04 jammy) and jazzy (24.04 noble).
# ROS_DISTRO_ARG / UBUNTU_CODENAME are only needed to pick the base image; after
# FROM everything uses ${ROS_DISTRO}, which the base image already sets, so the
# two can never drift apart.
ARG ROS_DISTRO_ARG=jazzy
ARG UBUNTU_CODENAME=noble
FROM ros:${ROS_DISTRO_ARG}-ros-base-${UBUNTU_CODENAME}

# Arguments
ARG USER=initial
ARG GROUP=initial
ARG UID=1000
ARG GID=${UID}
ARG SHELL=/bin/bash

# Replace apt urls.
# 24.04 (noble) moved the sources out of /etc/apt/sources.list into
# /etc/apt/sources.list.d/ubuntu.sources (deb822 format), so patch whichever
# is present rather than assuming either.
RUN for f in /etc/apt/sources.list /etc/apt/sources.list.d/ubuntu.sources; do \
      if [ -f "$f" ]; then \
        sed -i 's@archive.ubuntu.com@ftp.jaist.ac.jp/pub/Linux@g' "$f"; \
      fi; \
    done

# Install packages
RUN apt-get update && apt-get install -y --no-install-recommends \
    wget curl ssh unzip \
    zsh terminator gnome-terminal git vim tig \
    dbus-x11 libglvnd0 libgl1 libglx0 libegl1 libxext6 libx11-6 \
    ros-${ROS_DISTRO}-desktop \
    ros-${ROS_DISTRO}-ament-cmake ros-${ROS_DISTRO}-angles ros-${ROS_DISTRO}-controller-manager \
    ros-${ROS_DISTRO}-pluginlib ros-${ROS_DISTRO}-urdf ros-${ROS_DISTRO}-yaml-cpp-vendor ros-${ROS_DISTRO}-joint-state-pub* \
    ros-${ROS_DISTRO}-cv-bridge ros-${ROS_DISTRO}-diagnostic-updater \
    ros-${ROS_DISTRO}-moveit ros-${ROS_DISTRO}-rosbridge-server ros-${ROS_DISTRO}-urdf-launch  ros-${ROS_DISTRO}-urdf-tutorial \
    ros-${ROS_DISTRO}-xacro ros-${ROS_DISTRO}-realtime-tools ros-${ROS_DISTRO}-control-toolbox ros-${ROS_DISTRO}-ros2-control* ros-${ROS_DISTRO}-ros-testing \
    ros-${ROS_DISTRO}-teleop-twist-keyboard ros-${ROS_DISTRO}-vision-msgs ros-${ROS_DISTRO}-image-transport* \
  && apt-get clean \
  && rm -rf /var/lib/apt/lists/*

# 24.04 ships a PEP 668 "externally managed" Python, where a plain pip3 install
# refuses to touch the system site-packages. 22.04's pip is too old to know the
# --break-system-packages flag, so try the plain form first and fall back.
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3-pip v4l2loopback-dkms \
  && (pip3 install -U pyvirtualcam \
      || pip3 install -U --break-system-packages pyvirtualcam) \
  && apt-get clean \
  && rm -rf /var/lib/apt/lists/*

# Env vars for the nvidia-container-runtime.
ENV NVIDIA_VISIBLE_DEVICES=all
ENV NVIDIA_DRIVER_CAPABILITIES=graphics,utility,compute

# Setup users and groups.
# 24.04 ships a pre-created uid/gid 1000 (ubuntu), which collides with the host
# user on most desktops; drop it before creating ours.
RUN if getent passwd ${UID} >/dev/null && [ "$(getent passwd ${UID} | cut -d: -f1)" != "${USER}" ]; then \
      userdel -r "$(getent passwd ${UID} | cut -d: -f1)" 2>/dev/null || true; \
    fi \
  && if getent group ${GID} >/dev/null && [ "$(getent group ${GID} | cut -d: -f1)" != "${GROUP}" ]; then \
      groupdel "$(getent group ${GID} | cut -d: -f1)" 2>/dev/null || true; \
    fi \
  && groupadd --gid ${GID} ${GROUP} \
  && useradd --gid ${GID} --uid ${UID} -ms ${SHELL} ${USER} \
  && mkdir -p /etc/sudoers.d \
  && echo "${USER}:x:${UID}:${UID}:${USER},,,:$HOME:${shell}" >> /etc/passwd \
  && echo "${USER}:x:${UID}:" >> /etc/group \
  && echo "${USER} ALL=(ALL) NOPASSWD: ALL" > "/etc/sudoers.d/${USER}" \
  && chmod 0440 "/etc/sudoers.d/${USER}"

RUN ln -s /usr/lib/x86_64-linux-gnu/libdl.so.2 /usr/lib/x86_64-linux-gnu/libdl.so

# Switch user to ${USER}
USER ${USER}

# Setup Simulator app
RUN cd /home/${USER} && \
  wget -q https://github.com/REACT-ROBOT/Unity_ROS2_Robot_Simulator/releases/download/v1.0.1/Unity_ROS2_Robot_Simulator_v1.0.0_Linux_amd64.zip && \
  unzip Unity_ROS2_Robot_Simulator_v1.0.0_Linux_amd64.zip && \
  rm Unity_ROS2_Robot_Simulator_v1.0.0_Linux_amd64.zip

# Make SSH available
EXPOSE 22

# Switch to user's HOME folder
WORKDIR /home/${USER}/colcon_ws

RUN echo "source /opt/ros/${ROS_DISTRO}/setup.bash" >> ~/.bashrc
RUN echo "source /home/${USER}/colcon_ws/install/setup.sh" >> ~/.bashrc

ENTRYPOINT ["/bin/bash"]
